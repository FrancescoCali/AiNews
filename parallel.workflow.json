{
  "name": "ai-news-daily-workflow",
  "description": "Daily AI news scraping, analysis and static build (free mode).",
  "schedule": "30 8 * * *",
  "timezone": "Europe/Rome",
  "steps": [
    {
      "id": "scrape-apify",
      "type": "command",
      "command": "npm run scrape",
      "retries": 2
    },
    {
      "id": "analyze-claude",
      "type": "command",
      "command": "npm run analyze",
      "depends_on": ["scrape-apify"]
    },
    {
      "id": "generate-dashboard",
      "type": "command",
      "command": "npm run build:dashboard",
      "depends_on": ["analyze-claude"]
    },
    {
      "id": "publish",
      "type": "command",
      "command": "echo \"Publish handled by GitHub Pages workflow\"",
      "depends_on": ["generate-dashboard"]
    }
  ]
}
